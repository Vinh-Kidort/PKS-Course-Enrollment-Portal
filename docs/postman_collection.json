        {
          "name": "1. Register - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\npm.test(\"Trả về đúng user DTO\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res.success).to.be.true;\r\n    pm.expect(res.data).to.have.property(\"email\");\r\n    pm.expect(res.data).to.not.have.property(\"passwordHash\");\r\n    pm.environment.set(\"tempRegisterEmail\", \"user_\" + Date.now() + \"@pks.test\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"fullName\": \"Học viên Test\",\r\n  \"email\": \"{{$randomEmail}}\",\r\n  \"password\": \"Password@123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
